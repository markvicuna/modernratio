---
import '../styles/style.css';

const { title = 'Mark Vicuña' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@80,900&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <meta
      name="description"
      content="Mark Vicuña, filmmaker based in Helsinki, Finland. Documenting process, space & creative practice."
    />
    <title>{title}</title>
  </head>
  <body>
    <!-- Roughens the edges of the decorative shapes so they look inked. -->
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <filter id="rough">
        <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="4" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="5" />
      </filter>
    </svg>
    <!-- Slightly irregular letter edges for the inked-text effect. -->
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <filter id="ink-rough" x="-5%" y="-10%" width="110%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.08" numOctaves="2" seed="2" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="1" />
      </filter>
      <!-- Wobble for the hand-inked separator lines. -->
      <filter id="ink-line" x="-2%" y="-400%" width="104%" height="900%">
        <feTurbulence type="fractalNoise" baseFrequency="0.012 0.06" numOctaves="1" seed="6" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="0.8" />
      </filter>
    </svg>
    <div class="deco" aria-hidden="true">
      <span class="deco-slash"></span>
      <span class="deco-dot"></span>
    </div>
    <slot />
  </body>
</html>

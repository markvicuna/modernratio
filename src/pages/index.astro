---
import Layout from '../layouts/Layout.astro';

const links = [
  { href: 'https://www.instagram.com/mark.vicuna/', label: 'Instagram' },
  { href: 'https://www.youtube.com/user/MarkVicuna', label: 'YouTube' },
  { href: 'https://www.linkedin.com/in/mark-vicu%C3%B1a-487614207/', label: 'LinkedIn' },
];

// YouTube video ids
const videos = [
  'jyJ9Xpx1SMI',
  'E78VMQqGDb0',
  'WsB-0KY_waI',
  'VyXuaYAQ-dU',
  'pqkWx4DrbwQ',
  'W4NNDY4X9cc',
];
---

<Layout>
  <div class="container">
    <header class="bio">
      <div>
        <h1 class="logo">Mark Vicuña</h1>
        <p class="note">Developer / Videographer</p>
      </div>
      <div class="bio-row">
        <a href="mailto:mark.rvicuna@gmail.com">mark.rvicuna@gmail.com</a>
        <ul class="links">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </header>
    <main class="main">
      {videos.map((v, i) => (
        <figure class="video-item">
          <iframe
            class="video"
            src={`https://www.youtube.com/embed/${v}`}
            title="YouTube video player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          />
          <figcaption class="index">MV/F/{String(videos.length - i).padStart(3, '0')}</figcaption>
        </figure>
      ))}
    </main>
  </div>

  <footer class="footer">© Mark Vicuña, 2026</footer>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Video from '../components/Video.astro';

const links = [
  { href: 'https://www.instagram.com/mark.vicuna/', label: 'Instagram' },
  { href: 'https://www.youtube.com/user/MarkVicuna', label: 'YouTube' },
  { href: 'https://www.linkedin.com/in/mark-vicu%C3%B1a-487614207/', label: 'LinkedIn' },
];

// YouTube videos, newest first. The first one is featured.
const videos = [
  { id: 'jyJ9Xpx1SMI', title: 'Minestrone Tapes', year: 2026 },
  { id: 'E78VMQqGDb0', title: 'Eemeli Sahimaa, Practice Of / What Would I Do Without', year: 2025 },
  { id: 'WsB-0KY_waI', title: 'Paul Flanders, Kudos Collection', year: 2025 },
  { id: 'VyXuaYAQ-dU', title: 'Rudi Merz, Play in Progress', year: 2024 },
  { id: 'pqkWx4DrbwQ', title: 'Lennart Engels, Sauna Stone Lab', year: 2025 },
  { id: 'W4NNDY4X9cc', title: 'Marika Maijala, Island Artist', year: 2024 },
];

const [featured, ...recent] = videos;
---

<Layout>
  <div class="container">
    <header class="bio">
      <div>
        <h1 class="logo">Mark Vicuña</h1>
        <p class="note">Filmmaker / Developer</p>
      </div>
      <div class="bio-row">
        <a href="mailto:mark.rvicuna@gmail.com">mark.rvicuna@gmail.com</a>
        <ul class="links">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </header>
    <main class="main">
      <section>
        <h2 class="section-label">Featured project</h2>
        <Video {...featured} />
      </section>
      <section>
        <h2 class="section-label">Recent work</h2>
        <div class="grid">
          {recent.map((video) => (
            <Video {...video} />
          ))}
        </div>
      </section>
      <section class="about">
        <h2 class="section-label">About</h2>
        <div class="about-body">
          <div class="about-text">
            <p>
              I’m a Helsinki-based filmmaker and developer interested in people, places and creative
              practice. I work closely with artists, designers and makers, producing films from
              start to finish.
            </p>
            <p>
              I like to keep things small and close, focusing on atmosphere, process and the little
              moments that happen naturally.
            </p>
          </div>
          <dl class="details">
            <div>
              <dt>Based in</dt>
              <dd>Helsinki, Finland</dd>
            </div>
            <div>
              <dt>Available for</dt>
              <dd>Commissions and collaborations</dd>
            </div>
            <div>
              <dt>Contact</dt>
              <dd><a href="mailto:mark.rvicuna@gmail.com">mark.rvicuna@gmail.com</a></dd>
            </div>
          </dl>
        </div>
      </section>
    </main>
  </div>

  <footer class="footer">© Mark Vicuña, 2026</footer>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

// Links starting with http open in a new tab (mailto: stays in place).
const links = [
  { href: 'https://www.instagram.com/mark.vicuna/', icon: 'instagram', label: 'Instagram' },
  { href: 'https://www.youtube.com/user/MarkVicuna', icon: 'youtube', label: 'YouTube' },
  { href: 'https://www.linkedin.com/in/mark-vicu%C3%B1a-487614207/', icon: 'linkedin', label: 'LinkedIn' },
  { href: 'mailto:mark.rvicuna@gmail.com', icon: 'envelope', label: 'Email' },
];

// YouTube video ids
const videos = [
  'jyJ9Xpx1SMI',
  'E78VMQqGDb0',
  'WsB-0KY_waI',
  'VyXuaYAQ-dU',
  'pqkWx4DrbwQ',
  'W4NNDY4X9cc',
];
---

<Layout>
  <div class="container">
    <header class="bio">
      <h1>MARK VICUÑA</h1>
      <div class="note">Developer / Videographer</div>
      <ul class="social-link-group">
        {links.map((l) => (
          <li>
            <a
              class={`icon-${l.icon}`}
              href={l.href}
              target={l.href.startsWith('http') ? '_blank' : undefined}
              aria-label={l.label}
            >
              <Icon name={l.icon} />
            </a>
          </li>
        ))}
      </ul>
    </header>
    <main class="main">
      {videos.map((v) => (
        <iframe
          class="video"
          src={`https://www.youtube.com/embed/${v}`}
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        />
      ))}
    </main>
  </div>

  <footer class="footer">© Mark Vicuña, 2025</footer>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Video from '../components/Video.astro';

const links = [
  { href: 'https://www.instagram.com/mark.vicuna/', label: 'Instagram' },
  { href: 'https://www.youtube.com/user/MarkVicuna', label: 'YouTube' },
  { href: 'https://www.linkedin.com/in/mark-vicu%C3%B1a-487614207/', label: 'LinkedIn' },
];

// YouTube video ids, newest first. The first one is featured.
const videos = [
  'jyJ9Xpx1SMI',
  'E78VMQqGDb0',
  'WsB-0KY_waI',
  'VyXuaYAQ-dU',
  'pqkWx4DrbwQ',
  'W4NNDY4X9cc',
];

const [featured, ...recent] = videos;
---

<Layout>
  <div class="container">
    <header class="bio">
      <div>
        <h1 class="logo">Mark Vicuña</h1>
        <p class="note">Developer / Videographer</p>
      </div>
      <div class="bio-row">
        <a href="mailto:mark.rvicuna@gmail.com">mark.rvicuna@gmail.com</a>
        <ul class="links">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </header>
    <main class="main">
      <section>
        <h2 class="section-label">Featured project</h2>
        <Video id={featured} number={videos.length} />
      </section>
      <section>
        <h2 class="section-label">Recent work</h2>
        <div class="grid">
          {recent.map((id, i) => (
            <Video id={id} number={videos.length - 1 - i} />
          ))}
        </div>
      </section>
    </main>
  </div>

  <footer class="footer">© Mark Vicuña, 2026</footer>
</Layout>

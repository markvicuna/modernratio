---
import Layout from '../layouts/Layout.astro';
import Video from '../components/Video.astro';

const links = [
  { href: 'https://www.instagram.com/mark.vicuna/', label: 'Instagram' },
  { href: 'https://www.youtube.com/user/MarkVicuna', label: 'YouTube' },
  { href: 'https://www.linkedin.com/in/mark-vicu%C3%B1a-487614207/', label: 'LinkedIn' },
];

// YouTube videos, newest first. The first one is featured.
const videos = [
  { id: 'jyJ9Xpx1SMI', title: 'Minestrone Tapes', published: '2026-10-04T05:01:24-07:00' },
  { id: 'E78VMQqGDb0', title: 'Eemeli Sahimaa, Practice Of / What Would I Do Without', published: '2025-01-09T14:15:01-08:00' },
  { id: 'WsB-0KY_waI', title: 'Paul Flanders, Kudos Collection', published: '2025-01-08T12:24:58-08:00' },
  { id: 'VyXuaYAQ-dU', title: 'Rudi Merz, Play in Progress', published: '2024-09-19T00:00:19-07:00' },
  { id: 'pqkWx4DrbwQ', title: 'Lennart Engels, Sauna Stone Lab', published: '2025-01-09T08:00:51-08:00' },
  { id: 'W4NNDY4X9cc', title: 'Marika Maijala, Island Artist', published: '2024-06-12T04:00:26-07:00' },
].map((v) => ({ ...v, year: new Date(v.published).getUTCFullYear() }));

const [featured, ...recent] = videos;

// Structured data so search engines understand who this is and what the videos are.
const siteUrl = new URL('/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Mark Vicuña',
      jobTitle: 'Filmmaker and Developer',
      url: siteUrl,
      description: 'Filmmaker and developer based in Helsinki, Finland. Documenting process, space & creative practice.',
      address: { '@type': 'PostalAddress', addressLocality: 'Helsinki', addressCountry: 'FI' },
      sameAs: links.map((l) => l.href),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Mark Vicuña',
      publisher: { '@id': `${siteUrl}#person` },
    },
    ...videos.map((v) => ({
      '@type': 'VideoObject',
      name: v.title,
      description: `${v.title}, a video by Mark Vicuña.`,
      thumbnailUrl: `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`,
      uploadDate: v.published,
      embedUrl: `https://www.youtube.com/embed/${v.id}`,
      contentUrl: `https://www.youtube.com/watch?v=${v.id}`,
      creator: { '@id': `${siteUrl}#person` },
    })),
  ],
};
---

<Layout>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="container">
    <header class="bio">
      <div>
        <h1 class="logo">Mark Vicuña</h1>
        <p class="note">Filmmaker / Developer</p>
      </div>
      <div class="bio-row">
        <a href="mailto:mark.rvicuna@gmail.com">mark.rvicuna@gmail.com</a>
        <ul class="links">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </header>
    <main class="main">
      <section>
        <h2 class="section-label">Featured project</h2>
        <Video {...featured} />
      </section>
      <section>
        <h2 class="section-label">Recent work</h2>
        <div class="grid">
          {recent.map((video) => (
            <Video {...video} />
          ))}
        </div>
      </section>
      <section class="about">
        <h2 class="section-label">About</h2>
        <div class="about-body">
          <div class="about-text">
            <p>
              I’m a Helsinki-based filmmaker and developer interested in people, places and creative
              practice. I work closely with artists, designers and makers, producing films from
              start to finish.
            </p>
            <p>
              I like to keep things small and close, focusing on atmosphere, process and the little
              moments that happen naturally.
            </p>
          </div>
          <dl class="details">
            <div>
              <dt>Based in</dt>
              <dd>Helsinki, Finland</dd>
            </div>
            <div>
              <dt>Available for</dt>
              <dd>Commissions and collaborations</dd>
            </div>
            <div>
              <dt>Contact</dt>
              <dd><a href="mailto:mark.rvicuna@gmail.com">mark.rvicuna@gmail.com</a></dd>
            </div>
          </dl>
        </div>
      </section>
    </main>
  </div>

  <footer class="footer"><span>© Mark Vicuña, 2026</span></footer>
</Layout>
